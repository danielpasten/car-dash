# Copy to .env (next to your docker-compose.yml) and fill in. Never commit .env.

# Sign-in password for the app (long and random; you'll mostly use passkeys).
CAR_DASH_PASSWORD=
# Signs cookies and encrypts tokens the app stores. 32+ random bytes, e.g. `openssl rand -base64 48`.
# Changing it signs every device out and makes stored Tesla tokens / push keys unreadable.
CAR_DASH_SECRET=
# Password of the car_dash database role (see setup.sql).
CAR_DASH_DB_PASSWORD=

# Optional: Supercharger bills from your Tesla account (README › Supercharger bills)
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
